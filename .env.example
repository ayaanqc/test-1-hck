# AI provider key used ONLY by the server endpoint /api/ai. Never expose this in the frontend.
# Gemini accepts audio and video directly, so it is the default provider.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: "gemini" (default) or "openai". OpenAI also accepts audio.
AI_PROVIDER=gemini

# Optional model override
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini

# With no key set, the app still works: AI screens show prepared sample results labelled "demo result".
